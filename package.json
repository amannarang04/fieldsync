{
  "name": "fieldsync",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev --workspace=server\" \"npm:dev --workspace=client\"",
    "build": "npm run build --workspace=shared && npm run build --workspace=server && npm run build --workspace=client",
    "pretest": "npm run db:generate --workspace=server",
    "test": "npm run test --workspace=shared && npm run test --workspace=server",
    "e2e": "npm run build && playwright test",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:seed": "npm run db:seed --workspace=server"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "braces": "^3.0.4",
    "postcss-selector-parser": "^7.1.6",
    "shell-quote": "^1.11.0"
  }
}
